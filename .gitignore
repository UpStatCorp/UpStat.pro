# Environment files
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.idea/
.vscode/
.cursor/
*.swp

# OS
.DS_Store
Thumbs.db

# Databases
*.db
*.sqlite3
backup.sql
# Дампы БД: содержат ПДн пользователей и токены CRM. На проде они лежали
# в каталоге репозитория без правила — один `git add -A` опубликовал бы
# базу целиком в публичный репозиторий.
*.dump
*.sql.gz

# Uploads (user data)
uploads/
# Аватары — загруженные пользователями фотографии, то есть ПДн.
# Правило uploads/ их не покрывало: лежат внутри static.
app/static/avatars/
app/app/static/avatars/

# SSL certificates
ssl/
# На проде каталог называется ssl-etc/ и правилом выше не покрывался:
# приватный ключ сайта (privkey.pem) лежал там незаигнорированным.
ssl-etc/
# Любые ключи и сертификаты, где бы ни лежали.
*.pem
*.key
*.p12
*.pfx

# Logs
server.log
*.log

# Docker override (local settings)
docker-compose.override.yml

# Cookies / secrets
cookies.txt
*.bak
.crm_encryption_key
app/.crm_encryption_key

# Node modules
node_modules/
